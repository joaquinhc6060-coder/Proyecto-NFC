# =========================================================================
# VIGIO - VARIABLES DE ENTORNO
# =========================================================================
# Si dejas estas variables vacías o con los valores por defecto, el sistema
# debe configurarse explícitamente en cada entorno: testing o producción.
# =========================================================================

# --- 1. SUPABASE (Base de datos PostgreSQL, Auth & Storage) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- 2. PANEL MASTER (servidor; nunca usar prefijo VITE_ para secretos) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VIGIO_ADMIN_USERNAME=Benjuaco2026
# Cuenta técnica de Supabase Auth; no se usa como correo de contacto público.
VIGIO_ADMIN_EMAIL=master@vigio.cl
# Solo para ejecutar npm run admin:setup; quitar después de crear la cuenta.
VIGIO_ADMIN_INITIAL_PASSWORD=
# Clave privada para anonimizar el origen de los intentos de PIN. Genera una
# cadena aleatoria larga y configúrala también en Vercel antes de publicar.
VIGIO_PIN_RATE_LIMIT_SECRET=

# --- 3. ACCESO SOCIAL (secretos solo en el servidor / Supabase) ---
# Se configuran con node scripts/configure-activation.mjs --apply.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Token personal para configuración y migraciones; no se necesita en Vercel.
SUPABASE_ACCESS_TOKEN=
