# =========================================================================
# FINDEME SAAS RESTAURANTES & FIDELIZACIÓN IA - VARIABLES DE ENTORNO
# =========================================================================
# Si dejas estas variables vacías o con los valores por defecto, el sistema
# activará automáticamente el MODO MOCK / DESARROLLO (simulaciones hiperrealistas
# con delays controlados y datos coherentes para no bloquear tu frontend).
# =========================================================================

# --- 1. SUPABASE (Base de datos PostgreSQL, Auth & Storage) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- 2. INTELIGENCIA ARTIFICIAL & OCR (Lectura de Boletas y Perfilamiento) ---
# Opciones soportadas: 'gemini' o 'openai'
VITE_AI_PROVIDER=gemini
# Para Google Gemini (gemini-2.5-flash / gemini-1.5-flash): https://aistudio.google.com/
# Para OpenAI (gpt-4o-mini Vision): https://platform.openai.com/
VITE_AI_API_KEY=tu-api-key-de-gemini-o-openai

# --- 3. ALMACENAMIENTO CLOUD (Imágenes y PDFs de Boletas) ---
# Proveedores: 'supabase' | 'r2' | 's3'
VITE_STORAGE_PROVIDER=supabase
VITE_STORAGE_BUCKET_NAME=boletas
VITE_STORAGE_BUCKET_URL=https://tu-bucket.r2.cloudflarestorage.com

# --- 4. BILLETERAS DIGITALES (Apple Wallet & Google Wallet) ---
# Apple PassKit (.pkpass + Notificaciones Push APNs a pantalla de bloqueo)
VITE_APPLE_PASS_TYPE_ID=pass.cl.findeme.loyalty
VITE_APPLE_TEAM_ID=XXXXXXXXXX
VITE_APPLE_PASS_ENDPOINT=https://api.findeme.cl/wallet/apple/generate

# Google Wallet API (Loyalty Class / Generic Pass + Push)
VITE_GOOGLE_WALLET_ISSUER_ID=3388000000000000000
VITE_GOOGLE_WALLET_CLASS_ID=findeme_loyalty_class
VITE_GOOGLE_WALLET_ENDPOINT=https://api.findeme.cl/wallet/google/save-link

# --- 5. CANALES DE RESPALDO (Comensales sin Wallet instalada) ---
# Meta WhatsApp Cloud API
VITE_WHATSAPP_API_TOKEN=tu-whatsapp-bearer-token
VITE_WHATSAPP_PHONE_NUMBER_ID=100000000000000

# Resend Email API
VITE_RESEND_API_KEY=re_1234567890abcdef
VITE_RESEND_FROM_EMAIL=vip@findeme.cl

# --- 6. INTERRUPTOR MODO MOCK (Opcional, fuerza simulaciones aunque haya llaves) ---
# Valores: true | false (por defecto se autodetecta si faltan llaves)
VITE_USE_MOCK_APIS=false
